#!/bin/sh
# run-py -- run a hook script on the first Python >= 3.10 on PATH.
#
#   run-py <exit-code-if-none> <script> [args...]
#   run-py --check
#
# The hooks need Python 3.10; the python3 that ships with macOS is 3.9. This tries
# python3 first, then python3.14 down to python3.10, and execs the first one that is
# 3.10 or newer. With none, it exits with the code given: 2 for the merge gate (a
# blocking exit, so the gate fails closed) and 0 for the phrase arm (a prompt is
# never blocked). `--check` is the SessionStart hook: silent when a Python is found,
# otherwise one JSON message telling the human how to fix it.

find_python() {
  for py in python3 python3.14 python3.13 python3.12 python3.11 python3.10; do
    if command -v "$py" >/dev/null 2>&1 &&
       "$py" -c 'import sys; sys.exit(sys.version_info < (3, 10))' >/dev/null 2>&1; then
      printf '%s\n' "$py"
      return 0
    fi
  done
  return 1
}

MISSING='agent-guardrails: no Python 3.10 or newer on PATH, so the merge gate blocks every Bash command and the mgo phrase does nothing. Install Python 3.10+ (for example `brew install python@3.12`) and restart Claude Code.'

if [ "$1" = "--check" ]; then
  find_python >/dev/null && exit 0
  printf '{"systemMessage": "%s", "hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": "%s"}}\n' "$MISSING" "$MISSING"
  exit 0
fi

rc_if_none=$1
shift
if py=$(find_python); then
  exec "$py" "$@"
fi
printf '%s\n' "$MISSING" >&2
exit "$rc_if_none"
