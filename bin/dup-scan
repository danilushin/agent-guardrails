#!/bin/sh
# dup-scan -- run scripts/dup_scan.py with these arguments.
# Claude Code puts this bin/ on the Bash tool's PATH while the plugin is enabled.
# CLAUDE_PLUGIN_ROOT is not set there, so the wrapper finds the script from its
# own location.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 2
exec python3 "$here/../scripts/dup_scan.py" "$@"
